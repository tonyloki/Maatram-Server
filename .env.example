# Maatram Volunteering & Gamification Portal — Root Environment Template
# This file provides quick reference for configuring both backend and web services.

# --- Backend Configuration (server/.env) ---
# Copy server/.env.example to server/.env
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-32-char-secret-key-in-prod
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/maatram
DIRECT_URL=postgresql+asyncpg://postgres:password@localhost:5432/maatram
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]

# Third-party Integrations (Optional in Development)
CLOUDINARY_CLOUD_NAME=maatram
CLOUDINARY_API_KEY=test-cloudinary-key
CLOUDINARY_API_SECRET=test-cloudinary-secret
RESEND_API_KEY=re_test_key
RESEND_FROM_EMAIL=noreply@maatram.org
FIREBASE_CREDENTIALS_PATH=

# --- Web Frontend Configuration (web/.env.local) ---
# Copy web/.env.example to web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

