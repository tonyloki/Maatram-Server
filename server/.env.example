# Maatram Volunteering & Gamification Portal — Environment Configuration
# Copy this file to server/.env and configure values for your environment.
# Example: cp .env.example .env

# ==========================================
# Application Environment
# ==========================================
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Maatram Volunteering & Gamification Portal"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# ==========================================
# Security & Token Settings
# ==========================================
# Minimum 32 characters for production. Change this in staging/production!
SECRET_KEY="development-insecure-secret-key-change-in-production-min-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=15
MAX_OTP_ATTEMPTS=5
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
USE_DB_RATE_LIMITER=True

# ==========================================
# Database Connection (PostgreSQL / SQLite)
# ==========================================
# Runtime Application Pooler (Port 6543 - Transaction Mode on Supabase, or local PostgreSQL port 5432)
# For local development with SQLite fallback: sqlite+aiosqlite:///./test.db
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@YOUR_DB_HOST:6543/postgres"

# Direct / Migration Pooler (Port 5432 - Session Mode / DDL)
DIRECT_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@YOUR_DB_HOST:5432/postgres"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=True

# ==========================================
# CORS & Cookie Security
# ==========================================
# Allowed client frontend origins (JSON array or comma-separated string)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001"]
COOKIE_DOMAIN=""
COOKIE_PATH="/api/v1/auth"
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"

# ==========================================
# Configurable Business Policies
# ==========================================
LEADERBOARD_CYCLE_TYPE="CALENDAR_YEAR"
HOURS_ROUNDING_MODE="EXACT_DECIMAL_2"
EVENT_QUALIFICATION_MIN_MINUTES=60
INACTIVE_VOLUNTEER_DAYS_THRESHOLD=180
REGISTRATION_WITHDRAWAL_DEADLINE_HOURS_PRIOR=24
WAITLIST_PROMOTION_MODE="MANUAL"
APPLICATION_RESUBMISSION_ALLOWED=True
RESUBMISSION_COOLDOWN_DAYS=0
CORRECTION_SUPER_ADMIN_THRESHOLD_MINUTES=120
MINIMUM_VOLUNTEER_AGE=""
DEFAULT_EVENT_TIMEZONE="Asia/Kolkata"
EVENT_OVERBOOKING_PERCENTAGE=0.0
OUTBOX_MAX_RETRIES=3
OUTBOX_LEASE_TIMEOUT_SECONDS=300

# ==========================================
# Third-Party Integrations
# ==========================================
# Cloudinary (Media storage for event photos and avatars)
CLOUDINARY_CLOUD_NAME="maatram"
CLOUDINARY_API_KEY="test-cloudinary-key"
CLOUDINARY_API_SECRET="test-cloudinary-secret"
CLOUDINARY_MAX_FILE_SIZE_BYTES=10485760

# Resend (Email delivery service)
RESEND_API_KEY="re_test_key"
RESEND_FROM_EMAIL="noreply@maatram.org"

# Firebase Cloud Messaging (Push notifications - path to serviceAccountKey.json)
FIREBASE_CREDENTIALS_PATH=""

# Reports Export
REPORT_EXPORT_EXPIRE_DAYS=7
