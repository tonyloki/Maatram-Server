# Maatram Volunteering & Gamification Portal — Environment Configuration
# Copy this file to .env and configure values for your environment.

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="Maatram Volunteering & Gamification Portal"
API_V1_STR="/api/v1"

# Security & Tokens (Minimum 32 characters for production)
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# Runtime Application Pooler (Port 6543 - Transaction Mode)
DATABASE_URL="postgresql+asyncpg://user:password@host:6543/dbname"

# Direct / Migration Pooler (Port 5432 - Session Mode / DDL)
DIRECT_URL="postgresql+asyncpg://user:password@host:5432/dbname"

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# CORS & Cookies
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
COOKIE_DOMAIN=""
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"

# Configurable Business Policies (Pending Maatram Ratification)
LEADERBOARD_CYCLE_TYPE="CALENDAR_YEAR"
HOURS_ROUNDING_MODE="EXACT_DECIMAL_2"
EVENT_QUALIFICATION_MIN_MINUTES=60
INACTIVE_VOLUNTEER_DAYS_THRESHOLD=180
REGISTRATION_WITHDRAWAL_DEADLINE_HOURS_PRIOR=24
WAITLIST_PROMOTION_MODE="MANUAL"
APPLICATION_RESUBMISSION_ALLOWED=True
RESUBMISSION_COOLDOWN_DAYS=0
CORRECTION_SUPER_ADMIN_THRESHOLD_MINUTES=120
MINIMUM_VOLUNTEER_AGE=""
DEFAULT_EVENT_TIMEZONE="Asia/Kolkata"
EVENT_OVERBOOKING_PERCENTAGE=0.0
OUTBOX_MAX_RETRIES=3
OUTBOX_LEASE_TIMEOUT_SECONDS=300

